<!DOCTYPE html>
<html lang="en">
<head>
  <% var pageTitle = "Home" %>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <section class="hero">
    <h1>Find and book great events, effortlessly.</h1>
    <p>Browse upcoming online and offline events, reserve your seat in seconds, and manage your bookings all in one place.</p>
    <a href="/events" class="btn">Browse Events</a>
  </section>

  <main class="container">
    <h2>Upcoming Events</h2>
    <% if (upcomingEvents.length === 0) { %>
      <p class="field-hint">No upcoming events right now. Check back soon!</p>
    <% } else { %>
      <div class="grid">
        <% upcomingEvents.forEach(event => { %>
          <div class="card event-card">
            <span class="badge badge-<%= getEffectiveStatus(event) %>"><%= getEffectiveStatus(event) %></span>
            <h3><a href="/events/<%= event._id %>"><%= event.title %></a></h3>
            <div class="meta">
              📅 <%= new Date(event.date).toLocaleDateString() %> &middot; 🕐 <%= event.startTime %>
              &middot; <%= event.mode === 'online' ? '💻 Online' : '📍 ' + event.location %>
            </div>
            <div class="footer-row">
              <span class="field-hint"><%= event.availableSeats %> / <%= event.capacity %> seats left</span>
              <a href="/events/<%= event._id %>" class="btn btn-sm">View</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
