<!DOCTYPE html>
<html lang="en">
<head>
  <% var pageTitle = "Create Account" %>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div class="card" style="max-width: 420px; margin: 40px auto;">
      <h1>Create an Account</h1>
      <p class="field-hint">Register to create and manage your own events.</p>

      <% if (errorMessage) { %>
        <div class="alert alert-error"><%= errorMessage %></div>
      <% } %>

      <form method="POST" action="/register" class="stack">
        <div>
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required minlength="2" maxlength="100" value="<%= name %>" />
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required value="<%= email %>" />
        </div>
        <div>
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required minlength="8" />
          <div class="field-hint">At least 8 characters.</div>
        </div>
        <button type="submit" class="btn btn-block">Create Account</button>
      </form>

      <p class="field-hint" style="margin-top: 16px;">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
