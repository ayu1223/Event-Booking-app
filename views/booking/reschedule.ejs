<!DOCTYPE html>
<html lang="en">
<head>
  <% var pageTitle = "Reschedule Booking" %>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <h1>Reschedule Booking</h1>
    <p class="field-hint">
      Current: <strong><%= currentEvent ? currentEvent.title : 'Unknown event' %></strong>
      <% if (currentEvent) { %> on <%= new Date(currentEvent.date).toLocaleDateString() %><% } %>
    </p>

    <% if (errorMessage) { %>
      <div class="alert alert-error"><%= errorMessage %></div>
    <% } %>

    <% if (alternatives.length === 0) { %>
      <p class="field-hint">There are no other available events to reschedule to right now.</p>
    <% } else { %>
      <form method="POST" action="/bookings/<%= booking.bookingId %>/reschedule" class="stack">
        <div>
          <label for="email">Confirm your email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div>
          <label for="newEventId">Choose a new event</label>
          <select id="newEventId" name="newEventId" required>
            <% alternatives.forEach(ev => { %>
              <option value="<%= ev._id %>">
                <%= ev.title %> - <%= new Date(ev.date).toLocaleDateString() %> <%= ev.startTime %> (<%= ev.availableSeats %> seats left)
              </option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn">Confirm Reschedule</button>
      </form>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
